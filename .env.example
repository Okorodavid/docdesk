# Copy to .env (optional). Everything works without it in offline mode.

# With a key, answers come from Claude using only the help-centre excerpts,
# and the simulator's "Claude picks the tool" host brain is enabled.
ANTHROPIC_API_KEY=

# auto (Claude if a key is set, else offline), claude, or offline
ANSWER_MODE=auto
MODEL=claude-opus-5-5
PLANNER_MODEL=claude-haiku-5-5
EFFORT=low

BRAND_NAME=Brightline Internet
HOST=127.0.0.1
PORT=8765

# Staff token for the console and the support_gaps_report tool. Random per run if empty.
STAFF_TOKEN=

# Only when HOST is not 127.0.0.1: comma-separated public host names, for DNS-rebinding protection.
ALLOWED_HOSTS=

# Strands host (hosts/strands/host.py): Bedrock is used when AWS credentials resolve.
BEDROCK_MODEL_ID=us.amazon.nova-pro-v1:0
AWS_REGION=us-east-1
